<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#f8f8f4">
    <meta name="description" content="Thoughtful investment management for people building lasting wealth. Explore our approach and model an illustrative investment plan.">
    <title>Aura Capital | Invest with intention</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Libre+Baskerville:wght@400;700&display=swap" rel="stylesheet">
    <style>
        :root {
            color-scheme: light;
            --paper: #f8f8f4;
            --white: #fff;
            --ink: #1d2823;
            --muted: #66736b;
            --forest: #244b3b;
            --forest-dark: #163328;
            --lime: #cee78a;
            --line: #dfe4dc;
            --soft: #edf1e8;
            --clay: #bb6246;
            --serif: 'Libre Baskerville', Georgia, serif;
            --sans: 'DM Sans', sans-serif;
            --content: 1160px;
        }

        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; scroll-padding-top: 90px; }
        body { margin: 0; color: var(--ink); background: var(--paper); font: 16px/1.65 var(--sans); }
        a { color: inherit; }
        button, input, select, textarea { font: inherit; }
        button, a, input, select, textarea { -webkit-tap-highlight-color: transparent; }
        button:focus-visible, a:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 3px solid #89ae67; outline-offset: 3px; }
        .wrap { width: min(var(--content), calc(100% - 48px)); margin: 0 auto; }

        .site-header { position: sticky; top: 0; z-index: 10; background: rgba(248,248,244,.97); border-bottom: 1px solid var(--line); }
        .nav-row { min-height: 76px; display: flex; align-items: center; justify-content: space-between; gap: 30px; }
        .brand { display: inline-flex; align-items: center; gap: 11px; color: var(--forest-dark); font-size: 14px; font-weight: 700; letter-spacing: 0; text-decoration: none; white-space: nowrap; }
        .brand-mark { width: 31px; height: 31px; display: grid; place-items: center; border-radius: 50%; background: var(--forest); color: var(--lime); font: 16px/1 var(--serif); }
        .brand-name { letter-spacing: .03em; }
        .brand-name span { font-weight: 400; }
        .nav-links { display: flex; align-items: center; gap: 31px; }
        .nav-links a { color: var(--muted); text-decoration: none; font-size: 13px; font-weight: 500; transition: color .2s; }
        .nav-links a:hover { color: var(--forest); }
        .nav-links .nav-cta { padding: 10px 16px; background: var(--forest); color: white; }
        .nav-toggle { display: none; width: 42px; height: 42px; border: 1px solid var(--line); color: var(--forest); background: transparent; cursor: pointer; }

        .hero { position: relative; min-height: 548px; display: flex; align-items: center; overflow: hidden; background: #25362f; color: white; }
        .hero-image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 48%; }
        .hero-shade { position: absolute; inset: 0; background: rgba(16, 34, 27, .59); }
        .hero-content { position: relative; z-index: 1; width: min(var(--content), calc(100% - 48px)); margin: 0 auto; padding: 85px 0 90px; }
        .eyebrow { margin: 0 0 21px; color: var(--lime); font-size: 11px; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
        .hero h1 { max-width: 700px; margin: 0; font: 400 clamp(38px, 5.5vw, 67px)/1.14 var(--serif); letter-spacing: 0; }
        .hero-copy { max-width: 530px; margin: 23px 0 31px; color: rgba(255,255,255,.85); font-size: 16px; }
        .button { min-height: 48px; display: inline-flex; align-items: center; justify-content: center; gap: 12px; padding: 12px 19px; border: 1px solid transparent; border-radius: 2px; background: var(--lime); color: var(--forest-dark); font-size: 13px; font-weight: 700; text-decoration: none; transition: background .2s, transform .2s; }
        .button:hover { transform: translateY(-1px); background: #daefab; }
        .button svg { width: 15px; height: 15px; }
        .hero-note { display: inline-block; margin-left: 15px; color: rgba(255,255,255,.79); font-size: 12px; }

        .intro-band { border-bottom: 1px solid var(--line); background: var(--white); }
        .intro-row { min-height: 98px; display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr; align-items: center; gap: 24px; }
        .intro-lead { max-width: 295px; color: var(--muted); font-size: 13px; line-height: 1.55; }
        .fact { padding-left: 20px; border-left: 1px solid var(--line); }
        .fact strong { display: block; color: var(--forest); font: 21px/1.35 var(--serif); }
        .fact span { color: var(--muted); font-size: 11px; }

        .section { padding: 88px 0; }
        .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 30px; margin-bottom: 34px; }
        .section-kicker { margin: 0 0 12px; color: var(--clay); font-size: 11px; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
        .section h2 { margin: 0; font: 400 clamp(29px, 3.6vw, 43px)/1.2 var(--serif); letter-spacing: 0; }
        .section-heading > p { max-width: 410px; margin: 0; color: var(--muted); font-size: 14px; }
        .strategy-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
        .strategy { min-height: 239px; padding: 29px 27px 27px 0; }
        .strategy + .strategy { padding-left: 27px; border-left: 1px solid var(--line); }
        .strategy-index { color: var(--clay); font: 15px var(--serif); }
        .strategy h3 { margin: 18px 0 10px; font: 21px/1.35 var(--serif); }
        .strategy p { max-width: 305px; margin: 0; color: var(--muted); font-size: 13px; }

        .approach { padding: 78px 0 85px; background: var(--forest-dark); color: white; }
        .approach .section-kicker { color: var(--lime); }
        .approach-row { display: grid; grid-template-columns: 1fr 1.2fr; gap: 75px; align-items: start; }
        .approach h2 { max-width: 430px; }
        .approach-copy { color: #c9d5ce; font-size: 14px; }
        .approach-copy p { margin: 0 0 18px; }
        .approach-link { display: inline-flex; align-items: center; gap: 8px; margin-top: 7px; color: var(--lime); font-size: 13px; font-weight: 600; text-decoration: none; }
        .approach-link:hover { text-decoration: underline; }

        .simulator { background: var(--soft); }
        .simulator .section-heading { align-items: start; }
        .simulator-layout { display: grid; grid-template-columns: 340px minmax(0,1fr); background: var(--white); border: 1px solid var(--line); }
        .sim-controls { padding: 30px; border-right: 1px solid var(--line); }
        .field { margin-bottom: 25px; }
        .field label, .field-label { display: block; margin-bottom: 8px; color: var(--ink); font-size: 12px; font-weight: 600; }
        .field-hint { display: block; margin-top: 6px; color: var(--muted); font-size: 11px; }
        .money-input { position: relative; }
        .money-input span { position: absolute; top: 50%; left: 13px; color: var(--muted); transform: translateY(-50%); }
        .field input[type="number"], .field select { width: 100%; min-height: 45px; padding: 10px 12px; border: 1px solid #d7ded4; border-radius: 2px; background: var(--white); color: var(--ink); }
        .field input[type="number"] { padding-left: 28px; }
        .range-head { display: flex; justify-content: space-between; align-items: baseline; }
        .range-head output { color: var(--forest); font: 17px var(--serif); }
        .field input[type="range"] { width: 100%; height: 24px; margin: 0; accent-color: var(--forest); cursor: pointer; }
        .sim-result { min-width: 0; padding: 31px 34px 25px; }
        .result-label { margin: 0; color: var(--muted); font-size: 12px; }
        .result-value { margin: 2px 0 5px; color: var(--forest); font: 400 clamp(33px, 4.1vw, 49px)/1.2 var(--serif); overflow-wrap: anywhere; }
        .result-subtitle { margin: 0; color: var(--muted); font-size: 12px; }
        .chart-wrap { margin: 26px 0 15px; }
        .chart { display: block; width: 100%; height: auto; overflow: visible; }
        .chart-grid { stroke: #e9ede7; stroke-width: 1; }
        .chart-area { fill: rgba(71, 116, 83, .12); }
        .chart-line { fill: none; stroke: #477453; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
        .chart-baseline { fill: none; stroke: #bd6b50; stroke-width: 2; stroke-dasharray: 5 5; }
        .chart-years { display: flex; justify-content: space-between; color: var(--muted); font-size: 10px; }
        .chart-legend { display: flex; gap: 21px; margin-top: 13px; color: var(--muted); font-size: 11px; }
        .legend-dot { display: inline-block; width: 8px; height: 8px; margin-right: 6px; border-radius: 50%; background: #477453; }
        .legend-dot.coral { background: #bd6b50; }
        .result-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; padding-top: 17px; border-top: 1px solid var(--line); }
        .result-stats span { display: block; color: var(--muted); font-size: 11px; }
        .result-stats strong { display: block; margin-top: 3px; color: var(--ink); font-size: 15px; }
        .disclaimer { margin: 17px 0 0; color: var(--muted); font-size: 10px; line-height: 1.6; }

        .contact { background: #e9eee7; }
        .contact-grid { display: grid; grid-template-columns: .95fr 1.05fr; gap: 80px; align-items: start; }
        .contact-copy > p:not(.section-kicker) { max-width: 385px; color: var(--muted); font-size: 14px; }
        .contact-detail { margin-top: 25px; color: var(--muted); font-size: 12px; }
        .contact-detail a { color: var(--forest); font-weight: 600; }
        .contact-form { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
        .contact-form .field { margin: 0; }
        .contact-form .full { grid-column: 1 / -1; }
        .contact-form textarea { width: 100%; min-height: 105px; resize: vertical; padding: 12px; border: 1px solid #d0d8cf; border-radius: 2px; background: var(--white); }
        .contact-form button { justify-self: start; border: 0; cursor: pointer; }
        .form-status { grid-column: 1 / -1; min-height: 20px; margin: 0; color: var(--forest); font-size: 12px; }

        .site-footer { padding: 25px 0 30px; background: var(--forest-dark); color: #d4ded6; }
        .footer-top { display: flex; align-items: center; justify-content: space-between; gap: 25px; padding-bottom: 19px; border-bottom: 1px solid rgba(255,255,255,.17); }
        .footer-top .brand { color: white; }
        .footer-links { display: flex; gap: 21px; }
        .footer-links a { color: #d4ded6; font-size: 11px; text-decoration: none; }
        .footer-links a:hover { color: var(--lime); }
        .footer-disclaimer { max-width: 900px; margin: 17px 0 0; color: #afbeb4; font-size: 10px; line-height: 1.6; }
        .footer-bottom { display: flex; justify-content: space-between; gap: 20px; margin-top: 13px; color: #afbeb4; font-size: 10px; }

        @media (max-width: 760px) {
            .wrap { width: min(var(--content), calc(100% - 36px)); }
            .nav-row { min-height: 66px; }
            .nav-toggle { display: grid; place-items: center; }
            .nav-toggle svg { width: 19px; height: 19px; }
            .nav-links { position: absolute; top: 65px; left: 0; right: 0; display: none; align-items: stretch; gap: 0; padding: 8px 18px 16px; border-bottom: 1px solid var(--line); background: var(--paper); }
            .nav-links.is-open { display: flex; flex-direction: column; }
            .nav-links a { padding: 11px 4px; }
            .nav-links .nav-cta { margin-top: 6px; text-align: center; }
            .hero { min-height: 510px; }
            .hero-content { width: calc(100% - 36px); padding: 70px 0; }
            .hero h1 { max-width: 560px; }
            .hero-note { display: block; margin: 15px 0 0; }
            .intro-row { grid-template-columns: 1fr 1fr; gap: 17px; padding: 21px 0; }
            .intro-lead { max-width: none; grid-column: 1 / -1; }
            .fact { padding-left: 11px; }
            .section { padding: 67px 0; }
            .section-heading { display: block; }
            .section-heading > p { margin-top: 15px; }
            .strategy-grid { grid-template-columns: 1fr; }
            .strategy { min-height: 0; padding: 22px 0; }
            .strategy + .strategy { padding-left: 0; border-top: 1px solid var(--line); border-left: 0; }
            .strategy h3 { margin-top: 10px; }
            .approach { padding: 65px 0; }
            .approach-row { grid-template-columns: 1fr; gap: 22px; }
            .simulator-layout { grid-template-columns: 1fr; }
            .sim-controls { padding: 24px; border-right: 0; border-bottom: 1px solid var(--line); }
            .sim-result { padding: 25px 23px; }
            .contact-grid { grid-template-columns: 1fr; gap: 24px; }
            .footer-top, .footer-bottom { align-items: flex-start; flex-direction: column; }
            .footer-links { flex-wrap: wrap; gap: 9px 18px; }
        }
        @media (max-width: 420px) {
            .hero h1 { font-size: 37px; }
            .contact-form { grid-template-columns: 1fr; }
            .contact-form .full { grid-column: auto; }
            .result-stats { gap: 10px; }
            .footer-links { gap: 8px 14px; }
        }
        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; }
        }
    </style>
</head>
<body>
    <header class="site-header">
        <div class="wrap nav-row">
            <a class="brand" href="#home" aria-label="Aura Capital home"><span class="brand-mark" aria-hidden="true">A</span><span class="brand-name">AURA <span>CAPITAL</span></span></a>
            <button class="nav-toggle" id="navToggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="siteNav">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            </button>
            <nav class="nav-links" id="siteNav" aria-label="Main navigation">
                <a href="#approach">Our approach</a>
                <a href="#strategies">Strategies</a>
                <a href="#simulator">Planning tool</a>
                <a class="nav-cta" href="#contact">Talk with our team <span aria-hidden="true">&rarr;</span></a>
            </nav>
        </div>
    </header>

    <main id="home">
        <section class="hero" aria-labelledby="heroTitle">
            <img class="hero-image" src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=2000&q=85" alt="" fetchpriority="high">
            <div class="hero-shade" aria-hidden="true"></div>
            <div class="hero-content">
                <p class="eyebrow">Independent thinking. Invested together.</p>
                <h1 id="heroTitle">Make your wealth mean more.</h1>
                <p class="hero-copy">Clear advice and carefully built portfolios for people with a long view. Your ambitions set the direction; a thoughtful investment plan helps you move toward them.</p>
                <a class="button" href="#contact">Start a conversation <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg></a>
                <span class="hero-note">Personal advice. A patient perspective.</span>
            </div>
        </section>

        <section class="intro-band" aria-label="How we work">
            <div class="wrap intro-row">
                <p class="intro-lead">We put your goals before the noise, pairing steady guidance with a portfolio shaped around your life.</p>
                <div class="fact"><strong>By design</strong><span>Advice built around your goals</span></div>
                <div class="fact"><strong>For the long view</strong><span>Disciplined, patient investing</span></div>
                <div class="fact"><strong>With you</strong><span>A relationship, not a product</span></div>
            </div>
        </section>

        <section class="section" id="strategies">
            <div class="wrap">
                <div class="section-heading">
                    <div><p class="section-kicker">What we do</p><h2>Investing shaped around you.</h2></div>
                    <p>There is no universal portfolio. We start with your priorities, then build a clear plan to fit your time horizon and comfort with risk.</p>
                </div>
                <div class="strategy-grid">
                    <article class="strategy"><span class="strategy-index">01 / Plan</span><h3>Clarity before capital</h3><p>We work with you to understand what you are investing for, when you may need the money, and the trade-offs you are willing to make.</p></article>
                    <article class="strategy"><span class="strategy-index">02 / Build</span><h3>A portfolio with purpose</h3><p>We help design diversified portfolios across asset classes, guided by your goals rather than short-term market headlines.</p></article>
                    <article class="strategy"><span class="strategy-index">03 / Adapt</span><h3>Advice as life evolves</h3><p>As circumstances change, we revisit your plan together and help keep the investment decisions connected to your priorities.</p></article>
                </div>
            </div>
        </section>

        <section class="approach" id="approach">
            <div class="wrap approach-row">
                <div><p class="section-kicker">A considered approach</p><h2>Good investing is personal. So is good advice.</h2></div>
                <div class="approach-copy">
                    <p>Markets can be unpredictable. A well-formed plan can help make decisions more deliberate when they feel anything but. We bring together your objectives, your time horizon, and the risks you are prepared to take.</p>
                    <p>Our process is designed to be transparent: understand the whole picture, agree on a strategy, and stay in conversation as your needs change. No market forecast can remove risk, and no outcome is guaranteed.</p>
                    <a class="approach-link" href="#contact">Talk through your goals <span aria-hidden="true">&rarr;</span></a>
                </div>
            </div>
        </section>

        <section class="section simulator" id="simulator">
            <div class="wrap">
                <div class="section-heading">
                    <div><p class="section-kicker">Explore the possibilities</p><h2>A plan takes shape over time.</h2></div>
                    <p>Change the inputs to see how regular contributions and different assumed growth rates affect a hypothetical investment.</p>
                </div>
                <div class="simulator-layout">
                    <form class="sim-controls" id="projectionForm" aria-label="Investment projection assumptions" onsubmit="return false">
                        <div class="field">
                            <label for="initialInvestment">Starting investment</label>
                            <div class="money-input"><span aria-hidden="true">$</span><input id="initialInvestment" type="number" inputmode="decimal" min="0" max="100000000" step="1000" value="100000"></div>
                        </div>
                        <div class="field">
                            <label for="monthlyContribution">Monthly contribution</label>
                            <div class="money-input"><span aria-hidden="true">$</span><input id="monthlyContribution" type="number" inputmode="decimal" min="0" max="1000000" step="100" value="1500"></div>
                        </div>
                        <div class="field">
                            <label for="assumedRate">Illustrative annual growth rate</label>
                            <select id="assumedRate">
                                <option value="0.04">Lower assumption · 4%</option>
                                <option value="0.06" selected>Middle assumption · 6%</option>
                                <option value="0.08">Higher assumption · 8%</option>
                            </select>
                            <span class="field-hint">An assumption for illustration only, not a forecast.</span>
                        </div>
                        <div class="field">
                            <div class="range-head"><label for="years">Time horizon</label><output id="yearsOutput" for="years">20 years</output></div>
                            <input id="years" type="range" min="1" max="40" step="1" value="20">
                        </div>
                    </form>
                    <div class="sim-result" aria-live="polite">
                        <p class="result-label">Illustrative value after <span id="resultYears">20 years</span></p>
                        <p class="result-value" id="projectedValue">$0</p>
                        <p class="result-subtitle">Hypothetical ending balance if the selected assumption held steady.</p>
                        <div class="chart-wrap">
                            <svg class="chart" id="projectionChart" viewBox="0 0 600 205" role="img" aria-labelledby="chartTitle chartDesc">
                                <title id="chartTitle">Illustrative investment growth chart</title>
                                <desc id="chartDesc">A comparison of hypothetical investment value and total contributions over time.</desc>
                                <line class="chart-grid" x1="12" y1="25" x2="594" y2="25"/><line class="chart-grid" x1="12" y1="75" x2="594" y2="75"/><line class="chart-grid" x1="12" y1="125" x2="594" y2="125"/><line class="chart-grid" x1="12" y1="175" x2="594" y2="175"/>
                                <path class="chart-area" id="growthArea" d=""/><polyline class="chart-baseline" id="contributionLine" points=""/><polyline class="chart-line" id="growthLine" points=""/>
                            </svg>
                            <div class="chart-years"><span>Today</span><span id="chartEndYear">Year 20</span></div>
                            <div class="chart-legend"><span><i class="legend-dot"></i>Illustrative value</span><span><i class="legend-dot coral"></i>Total contributions</span></div>
                        </div>
                        <div class="result-stats">
                            <div><span>Total contributions</span><strong id="totalContributions">$0</strong></div>
                            <div><span>Illustrative growth</span><strong id="illustrativeGrowth">$0</strong></div>
                        </div>
                        <p class="disclaimer">This educational calculator is hypothetical, for illustration only, and is not financial advice or a forecast. Assumes monthly compounding and contributions at month-end. Does not account for fees, taxes, inflation, volatility, or withdrawals. Actual investment returns vary and may be negative. You could lose some or all of your investment.</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="section contact" id="contact">
            <div class="wrap contact-grid">
                <div class="contact-copy">
                    <p class="section-kicker">The next step</p>
                    <h2>Let’s talk about what matters to you.</h2>
                    <p>Share a little about what you are working toward. Our team will be in touch to arrange an introductory conversation.</p>
                    <p class="contact-detail">Prefer email? <a href="mailto:hello@auracapital.example">hello@auracapital.example</a><br>Serving clients by appointment.</p>
                </div>
                <form class="contact-form" id="contactForm">
                    <div class="field"><label for="name">Your name</label><input id="name" name="name" type="text" autocomplete="name" maxlength="100" required></div>
                    <div class="field"><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" maxlength="200" required></div>
                    <div class="field full"><label for="interest">What would you like to discuss?</label><select id="interest" name="interest"><option>Building an investment plan</option><option>Managing an existing portfolio</option><option>Planning for a life transition</option><option>Something else</option></select></div>
                    <div class="field full"><label for="message">A little more context <span style="font-weight:400;color:var(--muted)">(optional)</span></label><textarea id="message" name="message" maxlength="1500"></textarea></div>
                    <button class="button" type="submit">Prepare an email <span aria-hidden="true">&rarr;</span></button>
                    <p class="form-status" id="formStatus" role="status" aria-live="polite"></p>
                </form>
            </div>
        </section>
    </main>

    <footer class="site-footer" id="disclosures">
        <div class="wrap">
            <div class="footer-top">
                <a class="brand" href="#home"><span class="brand-mark" aria-hidden="true">A</span><span class="brand-name">AURA <span>CAPITAL</span></span></a>
                <nav class="footer-links" aria-label="Footer navigation"><a href="#approach">Our approach</a><a href="#strategies">Strategies</a><a href="#simulator">Planning tool</a><a href="#contact">Contact</a></nav>
            </div>
            <p class="footer-disclaimer">Aura Capital is a fictional business name used for this website template. This site is provided for general informational and educational purposes only and does not constitute investment, legal, tax, or other professional advice or an offer to buy or sell securities. Investing involves risk, including possible loss of principal. Past performance does not guarantee future results. The calculator uses hypothetical assumptions and is not a prediction of future performance. Before publishing, replace the sample business details and have the site's disclosures reviewed for your jurisdiction and services.</p>
            <div class="footer-bottom"><span>&copy; <span id="currentYear"></span> Aura Capital. All rights reserved.</span><a href="#disclosures" style="color:inherit">Important information</a></div>
        </div>
    </footer>

    <script>
        const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
        const initialInput = document.getElementById('initialInvestment');
        const contributionInput = document.getElementById('monthlyContribution');
        const rateInput = document.getElementById('assumedRate');
        const yearsInput = document.getElementById('years');

        function calculateProjection() {
            const initial = Math.min(100000000, Math.max(0, Number(initialInput.value) || 0));
            const contribution = Math.min(1000000, Math.max(0, Number(contributionInput.value) || 0));
            const annualRate = Number(rateInput.value) || 0;
            const years = Number(yearsInput.value);
            const monthlyRate = annualRate / 12;
            const values = [];
            const contributed = [];
            let balance = initial;

            values.push(balance);
            contributed.push(initial);
            for (let month = 1; month <= years * 12; month += 1) {
                balance = balance * (1 + monthlyRate) + contribution;
                if (month % 12 === 0) {
                    values.push(balance);
                    contributed.push(initial + contribution * month);
                }
            }

            const totalContributions = initial + contribution * years * 12;
            const growth = Math.max(0, balance - totalContributions);
            const chartWidth = 582;
            const chartHeight = 150;
            const chartTop = 20;
            const maximum = Math.max(1, balance, totalContributions);
            const points = values.map((value, index) => {
                const x = 12 + chartWidth * index / years;
                const y = chartTop + chartHeight * (1 - value / maximum);
                return `${x.toFixed(1)},${y.toFixed(1)}`;
            });
            const contributionPoints = contributed.map((value, index) => {
                const x = 12 + chartWidth * index / years;
                const y = chartTop + chartHeight * (1 - value / maximum);
                return `${x.toFixed(1)},${y.toFixed(1)}`;
            });

            document.getElementById('projectedValue').textContent = money.format(balance);
            document.getElementById('totalContributions').textContent = money.format(totalContributions);
            document.getElementById('illustrativeGrowth').textContent = money.format(growth);
            document.getElementById('yearsOutput').textContent = `${years} ${years === 1 ? 'year' : 'years'}`;
            document.getElementById('resultYears').textContent = `${years} ${years === 1 ? 'year' : 'years'}`;
            document.getElementById('chartEndYear').textContent = `Year ${years}`;
            document.getElementById('growthLine').setAttribute('points', points.join(' '));
            document.getElementById('contributionLine').setAttribute('points', contributionPoints.join(' '));
            document.getElementById('growthArea').setAttribute('d', `M ${points[0]} L ${points.join(' L ')} L 594,170 L 12,170 Z`);
            document.getElementById('chartDesc').textContent = `At the selected ${years}-year horizon, the illustrative value is ${money.format(balance)} and total contributions are ${money.format(totalContributions)}.`;
        }

        [initialInput, contributionInput, rateInput, yearsInput].forEach((input) => {
            input.addEventListener('input', calculateProjection);
            input.addEventListener('change', calculateProjection);
        });

        const navToggle = document.getElementById('navToggle');
        const siteNav = document.getElementById('siteNav');
        navToggle.addEventListener('click', () => {
            const isOpen = navToggle.getAttribute('aria-expanded') === 'true';
            navToggle.setAttribute('aria-expanded', String(!isOpen));
            navToggle.setAttribute('aria-label', isOpen ? 'Open navigation' : 'Close navigation');
            siteNav.classList.toggle('is-open', !isOpen);
        });
        siteNav.addEventListener('click', (event) => {
            if (event.target.closest('a')) {
                siteNav.classList.remove('is-open');
                navToggle.setAttribute('aria-expanded', 'false');
                navToggle.setAttribute('aria-label', 'Open navigation');
            }
        });

        document.getElementById('contactForm').addEventListener('submit', (event) => {
            event.preventDefault();
            const form = event.currentTarget;
            if (!form.reportValidity()) return;
            const data = new FormData(form);
            const subject = encodeURIComponent(`Introductory conversation: ${data.get('interest')}`);
            const body = encodeURIComponent(`Name: ${data.get('name')}\nEmail: ${data.get('email')}\nInterest: ${data.get('interest')}\n\n${data.get('message') || ''}`);
            document.getElementById('formStatus').textContent = 'Your email app will open with your message ready to send.';
            window.location.href = `mailto:hello@auracapital.example?subject=${subject}&body=${body}`;
        });

        document.getElementById('currentYear').textContent = new Date().getFullYear();
        calculateProjection();
    </script>
</body>
</html>
